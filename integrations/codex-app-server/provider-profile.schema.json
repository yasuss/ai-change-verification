{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-change-verification:codex-provider-profile:1",
  "title": "ACV Codex App Server Provider Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_version",
    "provider_kind",
    "codex_executable",
    "codex_executable_sha256",
    "codex_version",
    "schema_set_sha256",
    "schema_digest_algorithm",
    "platformFamily",
    "platformOs",
    "experimentalApi",
    "preflight_md_sha256",
    "preflight_json_sha256",
    "tested_capabilities",
    "expected_CODEX_HOME",
    "schema_digest_excluded_paths"
  ],
  "properties": {
    "profile_version": { "const": "1" },
    "provider_kind": { "const": "ACV_CODEX_APP_SERVER_COMMAND_EXEC_V1" },
    "codex_executable": { "type": "string", "pattern": "^[A-Za-z]:\\\\" },
    "codex_executable_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "codex_version": { "type": "string", "minLength": 1 },
    "schema_set_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "schema_digest_algorithm": { "type": "string", "minLength": 1 },
    "platformFamily": { "const": "windows" },
    "platformOs": { "const": "windows" },
    "experimentalApi": { "const": false },
    "preflight_md_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "preflight_json_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "expected_CODEX_HOME": { "const": "NOT_SET" },
    "schema_digest_excluded_paths": { "const": ["json/codex_app_server_protocol.v2.schemas.json"] },
    "config_requirements_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "provider_source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "canonical_install_files": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "tested_capabilities": { "type": "object", "additionalProperties": { "type": "boolean" } }
  }
}
